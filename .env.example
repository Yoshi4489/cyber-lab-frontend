# Optional. Only the Next.js server reads this; never use NEXT_PUBLIC_ for credentials.
# Leave unset to browse the preview without running the backend.
# `npm run api:types` fetches GET /v1/openapi.json from this origin.
BACKEND_URL=http://127.0.0.1:4000

# Required when enabling the same-origin BFF authentication routes. This is the
# browser-facing frontend origin, not an internal host or a forwarded header.
BFF_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Set both independently in a secret manager; do not put either in browser JavaScript.
# BFF_AUTH_SECRET must match the backend bootstrap credential.
BFF_AUTH_SECRET=
# BFF_SESSION_SECRET encrypts the opaque backend session before it enters the
# HttpOnly frontend cookie. It is frontend-only and must not match any backend secret.
BFF_SESSION_SECRET=

# Required by protected BFF routes for instances and submissions. These values
# are server-only and independent of the auth secrets.
BACKEND_SERVICE_TOKEN_SECRET=
SERVICE_TOKEN_ISSUER=
SERVICE_TOKEN_AUDIENCE=

# Optional. Set to `true` only on a deployment whose backend security gates are
# complete; it exposes the operator instance-control surface at /instances.
# Server-only on purpose: never expose this as NEXT_PUBLIC_, because the browser
# must not be able to reveal the surface. Unset means the route returns 404.
LIVE_INSTANCE_UI=
